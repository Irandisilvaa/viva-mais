{
  "expo": {
    "name": "Viva Mais",
    "slug": "viva-mais",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "vivamais",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
